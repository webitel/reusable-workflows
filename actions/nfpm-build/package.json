    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.8.1",
    "rollup": "^4.59.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
